## Step 9.	Differential expression analysis to compare RA baseline vs. follow-up time points within each cell type
de_by_celltype <- function(obj, timepoints = c("wk3", "wk6", "wk12"),
                           min_cells = 3) {
  obj <- JoinLayers(obj)          # one data layer before testing
  out <- list()

  for (ct in sort(unique(na.omit(obj$singler_label)))) {
    cells_ct <- subset(obj, subset = singler_label == ct)
    Idents(cells_ct) <- "timepoint"

    for (tp in timepoints) {
      n_tp <- sum(cells_ct$timepoint == tp)
      n_bl <- sum(cells_ct$timepoint == "BL")
      if (n_tp < min_cells || n_bl < min_cells) next   # too few cells to test

      m <- FindMarkers(
        cells_ct,
        ident.1         = tp,
        ident.2         = "BL",
        test.use        = "LR",
        latent.vars     = "donor",
        logfc.threshold = 0          # keep all genes; filter below
      )
      m$gene      <- rownames(m)
      m$cell_type <- ct
      m$timepoint <- tp
      out[[paste(ct, tp, sep = "_")]] <- m
    }
  }

  bind_rows(out)
}

