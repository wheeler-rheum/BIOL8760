run_pair <- function(d, tp) {
  pt <- sc_utils(seu_all)
  pt <- permutation_test(pt,
                         cluster_identity = "SingleR_label",
                         sample_1 = paste(d, "BL", sep = "_"),
                         sample_2 = paste(d, tp, sep = "_"),
                         sample_identity = "sample_id",
                         n_permutations = 1000)
  res <- as.data.frame(pt@results$permutation)   # adjust to the element name
  res$donor <- d
  res$timepoint <- tp
  res
}

