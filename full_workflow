## 6.ii.	Integration of each subset across batches to account for variance due to batch effect using anchor-based CCA intregration
integrate_subset <- function(obj, batch_col = "donor", dims = 1:14) {
  # Pick variable features once, on the full (unsplit) subset
  obj <- NormalizeData(obj)
  obj <- FindVariableFeatures(obj, nfeatures = 2000)
  hvg <- VariableFeatures(obj)

  # Split by donor after feature selection
  obj[["RNA"]] <- split(obj[["RNA"]], f = obj[[batch_col, drop = TRUE]])

  # Scale and reduce using the shared feature set
  obj <- ScaleData(obj, features = hvg)
  obj <- RunPCA(obj, features = hvg, npcs = max(dims))

  obj <- IntegrateLayers(
    object = obj,
    method = CCAIntegration,
    orig.reduction = "pca",
    new.reduction = "integrated.cca",
    dims = dims
  )
  obj
}

