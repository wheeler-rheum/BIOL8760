## Step 7: Repeat the clustering/annotation on the integrated subsets
ref <- celldex::MonacoImmuneData()
recluster_annotate <- function(obj, dims = 1:14, res = 0.5) {
  obj <- NormalizeData(obj, normalization.method = "LogNormalize", scale.factor = 10000)
  obj <- FindNeighbors(obj, reduction = "integrated.cca", dims = dims)
  obj <- FindClusters(obj, resolution = res, algorithm = 1)
  obj <- RunUMAP(obj, reduction = "integrated.cca", dims = dims)
  obj <- JoinLayers(obj)
  markers <- FindAllMarkers(obj, only.pos = TRUE)
  pred <- SingleR(
    test    = GetAssayData(obj, assay = "RNA", layer = "data"),
    ref     = ref,
    labels  = ref$label.main,
    clusters = obj$seurat_clusters
  )
  cluster_labels <- setNames(pred$labels, rownames(pred))
  obj$singler_label <- unname(cluster_labels[as.character(obj$seurat_clusters)])
  list(object = obj, markers = markers, singler = pred)
}

